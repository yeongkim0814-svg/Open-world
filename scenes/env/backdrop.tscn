[gd_scene format=4]

[sub_resource type="Shader" id="Shader_vkxof"]
code = "// 원경 산 능선 (Task 1). 위치 회복 반경 대신 vitality_global로 회색↔컬러.
// 아래(산기슭)는 어둡고 능선은 밝게. 공기 원근은 Environment 거리·높이 안개가 맡는다.
shader_type spatial;
render_mode cull_disabled, specular_disabled;

#include \"res://shaders/vitality.gdshaderinc\"

uniform vec4 albedo : source_color = vec4(0.3, 0.4, 0.3, 1.0);
uniform vec4 albedo_top : source_color = vec4(0.45, 0.5, 0.42, 1.0);
uniform float top_height = 400.0;

varying float h;

void vertex() {
	h = (MODEL_MATRIX * vec4(VERTEX, 1.0)).y;
}

void fragment() {
	vec3 c = mix(albedo.rgb, albedo_top.rgb, clamp(h / top_height, 0.0, 1.0));
	ALBEDO = mix(vitality_grey(c), c, clamp(vitality_global, 0.0, 1.0));
	ROUGHNESS = 1.0;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_gim0l"]
render_priority = 0
shader = SubResource("Shader_vkxof")
shader_parameter/albedo = Color(0.14, 0.21, 0.12, 1)
shader_parameter/albedo_top = Color(0.28, 0.36, 0.22, 1)
shader_parameter/top_height = 230.0

